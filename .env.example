# Backend and local Docker Compose settings. Copy to .env and replace placeholders before use.
APP_ENV=development
HTTP_ADDR=:8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scripd
DB_USER=scripd
DB_PASSWORD=replace-with-a-random-local-password
DB_SSLMODE=disable
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
SHUTDOWN_TIMEOUT=10s
READINESS_TIMEOUT=2s

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
# Local Docker Compose routes verification messages to Mailpit at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Scripd <noreply@scripd.local>"
SMTP_REQUIRE_TLS=false
NEXT_PUBLIC_API_URL=http://localhost:8080
API_PORT=8080
WEB_PORT=3000
